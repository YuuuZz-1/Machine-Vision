<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OpenCVRoot Condition="'$(OpenCVRoot)' == ''">D:\OpenCV_460\opencv\build</OpenCVRoot>
    <IncludePath>$(OpenCVRoot)\include;$(OpenCVRoot)\include\opencv2;$(IncludePath)</IncludePath>
    <LibraryPath>$(OpenCVRoot)\x64\vc15\lib;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>opencv_world460d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>